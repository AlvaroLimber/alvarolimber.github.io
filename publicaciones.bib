@article{chirino2017indigena,
  author   = {Chirino, Alvaro},
  title    = {¿Reducción de la auto pertenencia indígena en Bolivia? Una aplicación experimental en el diseño de cuestionarios},
  journal  = {Compendium: Cuadernos de Economía y Administración},
  volume   = {4},
  number   = {9},
  pages    = {12--34},
  year     = {2017},
  issn     = {1390-9894},
  keywords = {Artículo indexado},
  file     = {indigena2017.pdf},
  url      = {https://www.revistas.espol.edu.ec/index.php/compendium/article/view/273},
  abstract = {El Censo 2012 de Bolivia cambió el tipo de pregunta de auto pertenencia indígena respecto al censo de 2001, y los resultados oficiales mostraron una reducción del 20% en el indicador. El trabajo presenta un diseño experimental aplicado a 218 estudiantes universitarios, divididos aleatoriamente en dos grupos que recibieron la pregunta del censo 2012 o la del 2001. Mediante modelos logit y probit se encuentra una reducción del 12% en el indicador atribuible al cambio de la pregunta, lo que implica que ambas preguntas no son comparables, al menos en grupos con características similares al grupo experimental.}
}

